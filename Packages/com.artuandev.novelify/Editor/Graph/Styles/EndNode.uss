@import url("NovelNodeBase.uss");

.ge-node {
    min-width: 190px;
    background-color: #2d1620;
    border-left-color: #8e4358;
    border-right-color: #8e4358;
    border-bottom-color: #6f3546;
    border-top-color: #fb7185;
    --minimap-color: #fb7185;
}

.ge-node #title-container {
    background-color: #43202f;
    border-bottom-color: #8e4358;
}

.ge-node #title-container #subtitle {
    color: #ffa3b1;
}

.ge-node:checked {
    border-left-color: #ffa3b1;
    border-right-color: #ffa3b1;
    border-bottom-color: #ffa3b1;
}

.ge-node .ge-port {
    --port-color: #fb7185;
}
