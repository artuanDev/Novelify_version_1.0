/* Shared cinematic card treatment used by every Novelify story node. */
.ge-node {
    min-width: 250px;
    background-color: #142338;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 4px;
    border-bottom-width: 1px;
    border-left-color: #395b7c;
    border-right-color: #395b7c;
    border-top-color: #4ebaf4;
    border-bottom-color: #2a4762;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.ge-node:hover {
    border-left-color: #8bd6ff;
    border-right-color: #8bd6ff;
    border-bottom-color: #8bd6ff;
}

.ge-node:checked {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 5px;
    border-bottom-width: 2px;
}

.ge-node #title-container {
    min-height: 58px;
    padding-left: 14px;
    padding-right: 12px;
    padding-top: 9px;
    padding-bottom: 8px;
    background-color: #1b3350;
    border-bottom-color: #2f5a7d;
    border-bottom-width: 2px;
}

.ge-node #title-container #title {
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.ge-node #title-container #subtitle {
    color: #93b8d6;
    font-size: 10px;
    letter-spacing: 0.4px;
}

.ge-node #node-options {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 11px;
    padding-bottom: 12px;
}

.ge-node #port-container {
    padding-top: 8px;
    padding-bottom: 9px;
}

.ge-node .unity-base-field {
    margin-top: 4px;
    margin-bottom: 4px;
}

.ge-node .unity-base-field__label {
    color: #c6d8ea;
    font-size: 10px;
    letter-spacing: 0.3px;
}

.ge-node .unity-base-field__input,
.ge-node .unity-base-text-field__input,
.ge-node .unity-popup-field__input,
.ge-node .unity-enum-field__input,
.ge-node .unity-object-field__input {
    background-color: #060e1a;
    border-left-color: #3a5c7e;
    border-right-color: #3a5c7e;
    border-top-color: #3a5c7e;
    border-bottom-color: #3a5c7e;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.ge-node .unity-base-text-field__input:focus {
    border-left-color: #7cd4ff;
    border-right-color: #7cd4ff;
    border-top-color: #7cd4ff;
    border-bottom-color: #7cd4ff;
}

.ge-node .ge-port #label {
    color: #dce9f5;
    font-size: 10px;
    letter-spacing: 0.2px;
}
