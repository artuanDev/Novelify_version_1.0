@import url("NovelNodeBase.uss");

.ge-node {
    width: 520px;
    min-width: 520px;
    max-width: 520px;
    background-color: #221634;
    border-left-color: #6f4499;
    border-right-color: #6f4499;
    border-bottom-color: #58367a;
    border-top-color: #c084fc;
    --minimap-color: #c084fc;
}

.ge-node #title-container {
    background-color: #331f4d;
    border-bottom-color: #6f4499;
}

.ge-node #title-container #subtitle {
    color: #d9b0ff;
}

.ge-node:checked {
    border-left-color: #d9b0ff;
    border-right-color: #d9b0ff;
    border-bottom-color: #d9b0ff;
}

.ge-node .ge-port {
    --port-color: #c084fc;
}

/* Branch outputs stay amber: the fan-out is the point of the node. */
.ge-node .ge-port--direction-output {
    --port-color: #fbbf24;
}
